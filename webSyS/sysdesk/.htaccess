# SysDesk - Configuración de subdominio
# sysdesk.serviciosysistemas.com.ar

# Configuración de codificación
AddDefaultCharset UTF-8

# Habilitar motor de reescritura
RewriteEngine on

# Archivo index por defecto
DirectoryIndex index.php

# URLs amigables (ocultar .php)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# No indexar en buscadores
Header set X-Robots-Tag "noindex, nofollow"

# Headers de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# Proteger archivos sensibles
<Files ~ "\.(htaccess|htpasswd|log|txt|md)$">
    deny from all
</Files>

# Permitir descarga de ejecutables
<Files ~ "\.(exe)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
</Files>

# Cache para assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
</IfModule>
